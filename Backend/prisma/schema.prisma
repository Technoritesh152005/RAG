// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  
}

datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}

model Workspace{
  id String @id @default(uuid())
  name String
  description String
  userId String
  sources Source[]
  messages Message[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  
}

// url source schema
model Source {
  id String @id @default(uuid())
  url String
  workspaceId String
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  status SourceStatus @default(PENDING)
  pageCount Int?
  chunkCount Int?
  error String ?
  createdAt DateTime @default(now())

// this tells each url will have only one workspace 
  @@unique([url, workspaceId])

}

model Message {
  id String @id @default(uuid())
  workspaceId String 
  workspace  Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  role Role
  content String
  sources Json?
  createdAt DateTime @default(now())
}

enum SourceStatus {
  PENDING
  SCRAPING
  CHUNKING
  EMBEDDING
  DONE
  FAILED
}

enum Role{
   USER
  ASSISTANT
}
model Chunk {

  id String @id
  sourceId String
  workspaceId String
  pageUrl String
  pageTitle String
  sectionHeading String
  parentText String @db.Text
  childText String @db.Text
  chunkIndex Int 
  parentIndex Int
  createdAt DateTime @default(now())

  @@index([workspaceId])
  @@index([sourceId])
}


model FAQ {
  id String @id @default(uuid())
  workspaceId String
  question String
  answer String @db.text
  createdAt DateTime @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([workspaceId])
}

model ChunkHash{
  id String @id @default(uuid())
  contentHash String
  workspaceId String
  chunkId String
  createdAt DateTime @default(now())

  @@unique([contentHash, workspaceId])
  @@index([workspaceId])
}

model usageLog{
  id String @id @default(uuid())
  workspaceId String
  type String
  embeddingTokens Int @default(0)
  llmInputTokens   Int      @default(0)
  llmOutputTokens  Int      @default(0)
  latencyMs        Int?
  metadata         Json?
  createdAt        DateTime @default(now())

  @@index([workspaceId])
  @@index([type])
}
model EvalCase{
  id String @default(uuid())
  workspaceId String
  question String
  expectedPageUrls Json  // array of strings — pages that SHOULD be retrieved
  expectedKeyFacts Json  // array of strings — facts the answer must contain
   createdAt         DateTime @default(now())

  @@index([workspaceId])
}

model EvalRun {
  id String @id @default(uuid())
  workspaceId String 
  label String
  totalCases Int
  avgHitRate Float
   avgMRR          Float    // mean reciprocal rank of expected page
  avgJudgeScore   Float    // 0-1, LLM-judged answer quality
  confidentRate   Float    // % of cases where pipeline was confident (not fallback)
  avgLatencyMs    Int
  p95LatencyMs    Int
  createdAt       DateTime @default(now())
  results         EvalResult[]

  @@index([workspaceId])
}

model EvalResult{
   id               String   @id @default(uuid())
  runId            String
  run              EvalRun  @relation(fields: [runId], references: [id], onDelete: Cascade)
  caseId           String
  question         String
  retrievedUrls    Json     // pages actually retrieved, in rank order
  hit              Boolean  // was any expected page in retrieved set
  reciprocalRank   Float    // 0 if miss, 1/rank if hit
  judgeScore       Float    // 0-1
  judgeReasoning   String   @db.Text
  confident        Boolean
  latencyMs        Int
  generatedAnswer  String   @db.Text
  createdAt        DateTime @default(now())

  @@index([runId])
}